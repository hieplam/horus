# Secrets
.env

# Model files are gigabytes. They never belong in git.
*.safetensors
*.ckpt
*.gguf
*.pt
*.pth
*.bin
*.onnx

# Unfinished downloads and archives
*.part
*.7z

# Generated images. Only the result image of a saved prompt is kept.
*.png
*.jpg
*.jpeg
*.webp
!prompts/*/*.png

# Go build output
bin/

# Local scratch space and logs
.scratch/
*.log

# Python and OS files
__pycache__/
*.egg-info/
*.pyc
.DS_Store
Thumbs.db
