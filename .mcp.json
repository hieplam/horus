{
  "mcpServers": {
    "comfy-mcp": {
      "type": "stdio",
      "command": "horus",
      "args": ["comfy-mcp"],
      "env": {
        "COMFY_LOCAL_URL": "${COMFY_LOCAL_URL:-http://127.0.0.1:8188}"
      }
    },
    "horus": {
      "type": "stdio",
      "command": "horus",
      "args": ["mcp"]
    }
  }
}
